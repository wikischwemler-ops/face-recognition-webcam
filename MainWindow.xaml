<Window x:Class="FaceTrackingApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FaceTrackingApp.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        Title="Gesichtserkennung &amp; Verfolgung"
        Height="820" Width="1360" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,3" />
        </Style>

        <Style x:Key="StatName" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
            <Setter Property="Margin" Value="0,3,12,3" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================== Werkzeugleiste -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource StrokeBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE8D4;" FontSize="22"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0" />
                    <StackPanel>
                        <TextBlock Text="Gesichtserkennung" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Echtzeit-Erkennung &amp; Verfolgung" FontSize="12"
                                   Foreground="{StaticResource SubtleTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <WrapPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Label}" Text="Kamera" />
                    <ComboBox Width="340" ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera}"
                              ToolTip="Alle aktuell im Geräte-Manager aktivierten Kameras" VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="{Binding KindIcon}"
                                               FontSize="15" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                               MaxWidth="200" TextTrimming="CharacterEllipsis" />
                                    <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4"
                                            Background="{StaticResource BadgeBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding KindLabel}" FontSize="11"
                                                   Foreground="{StaticResource TextBrush}" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Command="{Binding RefreshCamerasCommand}" Margin="6,0,0,0" Padding="9,6"
                            ToolTip="Kameraliste neu einlesen" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;" FontSize="14" />
                    </Button>

                    <TextBlock Style="{StaticResource Label}" Text="Auflösung" Margin="18,0,8,0" />
                    <ComboBox Width="130" ItemsSource="{Binding Resolutions}" SelectedItem="{Binding SelectedResolution}"
                              VerticalAlignment="Center" />

                    <CheckBox Content="Spiegeln" IsChecked="{Binding Mirror}" Margin="18,0,0,0" VerticalAlignment="Center" />
                    <CheckBox Content="Rahmen" IsChecked="{Binding ShowOverlay}" Margin="12,0,0,0" VerticalAlignment="Center" />

                    <Button Command="{Binding ToggleCameraCommand}" Margin="18,0,0,0" Padding="16,7"
                            Background="{StaticResource AccentBrush}" Foreground="#0B1A26" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="{Binding ToggleButtonIcon}"
                                       FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding ToggleButtonText}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ============================== Inhalt -->
        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- Video + Overlay: beide in derselben Pixel-Fläche, die Viewbox skaliert sie gemeinsam -->
            <Border Grid.Column="0" Background="Black" CornerRadius="8" BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <Viewbox Stretch="Uniform">
                        <Grid Width="{Binding FrameWidth}" Height="{Binding FrameHeight}">
                            <Image Source="{Binding VideoSource}" Stretch="Fill"
                                   RenderOptions.BitmapScalingMode="Linear" RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding ImageScaleX}" />
                                </Image.RenderTransform>
                            </Image>

                            <ItemsControl ItemsSource="{Binding Faces}" IsHitTestVisible="False"
                                          Visibility="{Binding ShowOverlay, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="{Binding Width}" Height="{Binding Height}">
                                            <Rectangle x:Name="Box" RadiusX="6" RadiusY="6"
                                                       Stroke="{StaticResource FaceBrush}"
                                                       StrokeThickness="{Binding StrokeThickness}" />

                                            <!-- Fadenkreuz nur beim Hauptgesicht (größtes) -->
                                            <Grid x:Name="Cross" Visibility="Collapsed">
                                                <Rectangle Width="{Binding CrossSize}" Height="{Binding StrokeThickness}"
                                                           Fill="{StaticResource PrimaryFaceBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Rectangle Width="{Binding StrokeThickness}" Height="{Binding CrossSize}"
                                                           Fill="{StaticResource PrimaryFaceBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>

                                            <Border x:Name="Tag" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    Background="{StaticResource FaceBrush}" CornerRadius="0,0,6,0"
                                                    Padding="6,1">
                                                <TextBlock Text="{Binding Label}" FontSize="{Binding FontSize}"
                                                           FontWeight="SemiBold" Foreground="#0D1A0B" />
                                            </Border>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                <Setter TargetName="Box" Property="Stroke" Value="{StaticResource PrimaryFaceBrush}" />
                                                <Setter TargetName="Tag" Property="Background" Value="{StaticResource PrimaryFaceBrush}" />
                                                <Setter TargetName="Cross" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Viewbox>

                    <!-- Platzhalter -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE722;" FontSize="56"
                                   HorizontalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" />
                        <TextBlock Text="Kamera auswählen und „Kamera starten“ klicken" Margin="0,14,0,0"
                                   HorizontalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" />
                        <TextBlock Text="Keine Kamera gefunden – USB-Kamera anschließen oder im Geräte-Manager aktivieren."
                                   Margin="0,6,0,0" HorizontalAlignment="Center" Foreground="{StaticResource WarningBrush}"
                                   Visibility="{Binding HasNoCameras, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Seitenleiste -->
            <Border Grid.Column="1" Margin="12,0,0,0" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <Border DockPanel.Dock="Right" Background="{StaticResource BadgeBrush}" CornerRadius="10"
                                Padding="10,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FaceCount}" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="Erkannte Gesichter" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Faces}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ScoreText}"
                                                   Foreground="{StaticResource FaceBrush}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding PositionText}" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" />
                                    <TextBlock Text="{Binding SizeText}" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <Rectangle Height="1" Fill="{StaticResource StrokeBrush}" Margin="0,0,0,10" />
                        <TextBlock Text="Leistung" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition />
                                <RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Style="{StaticResource StatName}" Text="Kamera-FPS" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource StatValue}" Text="{Binding CameraFpsText}" />
                            <TextBlock Grid.Row="1" Style="{StaticResource StatName}" Text="Anzeige-FPS" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource StatValue}" Text="{Binding DisplayFpsText}" />
                            <TextBlock Grid.Row="2" Style="{StaticResource StatName}" Text="Erkennung" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource StatValue}" Text="{Binding DetectionText}" />
                            <TextBlock Grid.Row="3" Style="{StaticResource StatName}" Text="Auflösung" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource StatValue}" Text="{Binding ResolutionText}" />
                            <TextBlock Grid.Row="4" Style="{StaticResource StatName}" Text="Treiber" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource StatValue}" Text="{Binding BackendText}" />
                            <TextBlock Grid.Row="5" Style="{StaticResource StatName}" Text="Detektor" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource StatValue}" Text="{Binding DetectorName}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================== Statusleiste -->
        <Border Grid.Row="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource StrokeBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="Verarbeitung lokal – keine Bilder verlassen den PC"
                           FontSize="12" Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center" />
                <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
